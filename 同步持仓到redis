# -*- coding: gbk -*-
# 占比% = m_nVolume * m_dSettlementPrice / m_dBalance * 100
# Redis 队列每行: 代码\t名称\t持仓\t结算价\t市值\t占比%

_ACCOUNT_ID = ""  # 资金账号；模拟时可填
account = ""
_done = False

REDIS_ENABLE = True
REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_PASSWORD = ""
REDIS_DB = 0
REDIS_QUEUE_KEY = "qmt:position_pct"  # 公共队列 key，所有账户对比都读这一个
REDIS_EXPIRE_SEC = 3600
REDIS_ENCODE_BASE64 = True  # 金阳光 QMT 对明文 LRANGE/GET 可能报 Sensitive Data，用 base64


def _line_text(code, name, vol, price, mv, pct):
    # 与控制台打印格式一致的一行文本
    return u"%s\t%s\t%s\t%.4f\t%.2f\t%.2f%%" % (code, name, vol, price, mv, pct)


def _push_queue_to_redis(lines):
    if not REDIS_ENABLE:
        return
    try:
        import base64
        import redis
    except ImportError:
        print(u"未安装 redis，跳过。QMT Python: pip install redis")
        return
    try:
        r = redis.Redis(
            host=REDIS_HOST,
            port=REDIS_PORT,
            password=REDIS_PASSWORD or None,
            db=REDIS_DB,
            decode_responses=True,
        )
        key = REDIS_QUEUE_KEY
        text = u"\n".join([x if isinstance(x, type(u"")) else str(x) for x in lines])
        if REDIS_ENCODE_BASE64:
            payload = base64.b64encode(text.encode("utf-8")).decode("ascii")
        else:
            payload = text
        if REDIS_EXPIRE_SEC > 0:
            r.setex(key, REDIS_EXPIRE_SEC, payload)
        else:
            r.set(key, payload)
        print(u"已推送 Redis", REDIS_HOST, u":", REDIS_PORT, u"key=", key, u"条数=", len(lines))
        if len(lines) <= 0:
            print(u"警告: 推送条数为 0，对比策略读不到数据")
    except Exception as e:
        print(u"Redis 推送失败:", e)


def init(ContextInfo):
    print(u"持仓占比 init")


def handlebar(ContextInfo):
    global _done
    if not ContextInfo.is_last_bar() or _done:
        return
    acc = str(_ACCOUNT_ID or getattr(ContextInfo, "accid", "") or account or "").strip()
    if not acc:
        print(u"未指定资金账号")
        return

    total = 0.0
    for t in ("STOCK", "HUGANGTONG", "SHENGANGTONG"):
        try:
            for a in get_trade_detail_data(acc, t, "ACCOUNT") or []:
                b = float(getattr(a, "m_dBalance", 0) or 0)
                if b > total:
                    total = b
        except Exception:
            pass
    if total <= 0:
        print(u"总资产为0")
        return

    print(u"账号", acc, u"总资产", round(total, 2))
    print(u"代码\t名称\t持仓\t结算价\t市值\t占比%")

    seen = set()
    queue_lines = []
    for t in ("STOCK", "HUGANGTONG", "SHENGANGTONG"):
        try:
            for p in get_trade_detail_data(acc, t, "POSITION") or []:
                code = str(getattr(p, "m_strInstrumentID", "") or "").strip()
                ex = str(getattr(p, "m_strExchangeID", "") or "").strip()
                if code and ex and "." not in code:
                    code = code + "." + ex
                if not code or code in seen:
                    continue
                seen.add(code)
                vol = int(float(getattr(p, "m_nVolume", 0) or 0))
                price = float(getattr(p, "m_dSettlementPrice", 0) or 0)
                if vol <= 0 or price <= 0:
                    continue
                mv = vol * price
                pct = mv / total * 100.0
                name = str(getattr(p, "m_strInstrumentName", "") or "")
                line = _line_text(code, name, vol, price, mv, pct)
                print(line)
                queue_lines.append((pct, line))
        except Exception:
            pass

    queue_lines.sort(key=lambda x: -x[0])
    lines_only = [x[1] for x in queue_lines]
    print(u"推送到公共队列 key=", REDIS_QUEUE_KEY)
    _push_queue_to_redis(lines_only)
    _done = True


